{
  "name": "Dexa API",
  "tagline": "Contract-first decider and extractor API for LLM workloads",
  "version": "0.5.0",
  "description": "Run many decider and extractor tasks in a single, compact, non-streaming request. SDKs for TypeScript, Python, Ruby, Rust, Java and .NET.",
  "basePath": "/",
  "repo": "https://github.com/dsainvg/decide-extract-sdk",
  "editablePages": true,
  "packages": {
    "typescript": { "name": "@dsainvg/dexa-ai-sdk", "registry": "npm", "install": "npm install @dsainvg/dexa-ai-sdk", "dir": "packages/sdk-ts", "client": "DexaAiSdkClient" },
    "python": { "name": "dexa-ai-sdk", "registry": "PyPI", "install": "pip install dexa-ai-sdk", "dir": "packages/sdk-py", "client": "DexaAiSdkClient" },
    "ruby": { "name": "dexa-ai-sdk", "registry": "RubyGems", "install": "gem install dexa-ai-sdk", "dir": "packages/sdk-ruby" },
    "rust": { "name": "(from packages/sdk-rust/Cargo.toml)", "registry": "crates.io", "install": "cargo add decide-extractor", "dir": "packages/sdk-rust" },
    "java": { "name": "com.dsainvg:dexa-ai-sdk", "registry": "GitHub Release", "install": "implementation(\"com.dsainvg:dexa-ai-sdk:0.3.0\")", "dir": "packages/sdk-java" },
    "csharp": { "name": "(from packages/sdk-csharp/*.csproj)", "registry": "NuGet", "install": "dotnet add package DecideExtractor", "dir": "packages/sdk-csharp" }
  },
  "api": {
    "title": "Dexa API",
    "baseUrl": "http://localhost:8080",
    "spec": "fern/openapi/openapi.yml"
  },
  "sections": [
    { "title": "Getting started", "match": "getting-started" },
    { "title": "Guides", "match": "guides" },
    { "title": "API reference", "match": "api-reference" },
    { "title": "Operations", "match": "operations" }
  ]
}